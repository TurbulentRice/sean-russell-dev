// Cloudflare Worker serving the built site as static assets. No Worker code
// yet, so requests never invoke (or bill) a script. When an experiment needs
// an API, add `main` and route only /api/* to it (assets.run_worker_first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sean-russell-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // dist/404.html for anything that isn't a file.
    "not_found_handling": "404-page",
    // /about → /about/, matching Astro's trailingSlash: 'always'.
    "html_handling": "auto-trailing-slash"
  },
  // PR builds run `wrangler preview`, which needs this block (it can be
  // empty). Each PR gets a preview URL on workers.dev, kept out of search by
  // public/_headers.
  "previews": {},
  // The site's real address: the bare domain (BRIEF, "How"). Deploying creates
  // the DNS record and certificate, and turns the workers.dev address off (PR
  // previews stay on). www redirects here via a Cloudflare Redirect Rule
  // (dashboard; see docs/working/p1-foundation/CUTOVER.md, phase 2).
  "routes": [{ "pattern": "seanrusselldev.com", "custom_domain": true }]
}
