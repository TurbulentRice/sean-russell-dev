# Response headers for the static site (Cloudflare Workers static assets).

# Astro's build output is content-hashed, so it never changes at a given URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep the workers.dev addresses (production and version previews) out of
# search results; the real site is seanrusselldev.com.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
