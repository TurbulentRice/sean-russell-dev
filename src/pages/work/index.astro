---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { published } from '../../lib/content';

const entries = await published('work');
---

<Base title="Work" description="Case studies: the problem, the decisions, and what came of them.">
  <div class="page">
    <header class="stack">
      <h1>Work</h1>
      <p class="muted intro">Case studies: the problem, the constraints, the decisions, and what came of them.</p>
    </header>
    {entries.length === 0 && <p class="muted">Case studies are being written. Check back soon.</p>}
    <IndexList rows={entries.map((e) => ({ href: `/work/${e.id}/`, title: e.data.title, summary: e.data.summary, meta: e.data.area, draft: e.data.draft }))} />
  </div>
</Base>

<style>
  .intro { max-width: 52ch; }
</style>
