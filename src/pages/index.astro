---
import Base from '../layouts/Base.astro';
import IndexList from '../components/IndexList.astro';
import { published } from '../lib/content';
import { site } from '../site.config';

const work = (await published('work')).filter((e) => e.data.featured).slice(0, 3);
const lab = (await published('lab')).slice(0, 3);
---

<Base>
  <div class="page">
    <section class="hero">
      <h1>{site.headline}</h1>
      <p class="lede muted">{site.lede}</p>
      {/* The live trace (src/components/Trace.astro) goes here once /status exists (P4). */}
    </section>

    {work.length === 0 && (
      <section class="section">
        <h2 class="label">Selected work</h2>
        <p class="muted pending">Case studies are being written. Check back soon.</p>
      </section>
    )}

    {work.length > 0 && (
      <section class="section">
        <h2 class="label">Selected work</h2>
        <IndexList rows={work.map((e) => ({ href: `/work/${e.id}/`, title: e.data.title, summary: e.data.summary, meta: e.data.area, draft: e.data.draft }))} />
      </section>
    )}

    {lab.length > 0 && (
      <section class="section">
        <h2 class="label">From the lab</h2>
        <IndexList numbered={false} rows={lab.map((e) => ({ href: `/lab/${e.id}/`, title: e.data.title, summary: e.data.summary, status: e.data.status, draft: e.data.draft }))} />
      </section>
    )}
  </div>
</Base>

<style>
  .hero { display: grid; gap: var(--space-4); padding-block: var(--space-6) 0; }
  .hero h1 { max-width: 20ch; }
  .pending { padding-block: var(--space-4); border-block: 1px solid var(--line); font-size: var(--step--1); }
  .lede { max-width: 52ch; font-size: var(--step-1); line-height: 1.5; }
</style>
