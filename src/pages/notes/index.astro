---
// Built but not in the nav until there are a few posts (site.config.ts).
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { published } from '../../lib/content';

const entries = await published('notes');
---

<Base title="Notes" description="Short technical write-ups." noindex={entries.length === 0}>
  <div class="page">
    <h1>Notes</h1>
    {entries.length === 0 ? <p class="muted">Nothing here yet.</p> : (
      <IndexList numbered={false} rows={entries.map((e) => ({ href: `/notes/${e.id}/`, title: e.data.title, summary: e.data.summary, meta: e.data.date.toISOString().slice(0, 10), draft: e.data.draft }))} />
    )}
  </div>
</Base>
