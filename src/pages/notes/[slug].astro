---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published } from '../../lib/content';

export async function getStaticPaths() {
  return (await published('notes')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} noindex={entry.data.draft}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="muted">{entry.data.date.toISOString().slice(0, 10)}</p>
    <Content />
  </article>
</Base>
