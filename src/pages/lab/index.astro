---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import Status from '../../components/Status.astro';
import { published } from '../../lib/content';

const entries = await published('lab');
---

<Base title="Lab" description="Experiments. Some polished, some not, all labelled.">
  <div class="page">
    <header class="stack">
      <h1>Lab</h1>
      <p class="muted intro">Experiments, some polished and some not. Each one is labelled.</p>
      <p class="key">
        <Status status="live" /> works and is maintained
        <Status status="wip" /> still moving
        <Status status="archived" /> kept for the record
      </p>
    </header>
    {entries.length === 0 && <p class="muted">The first experiments are on the bench.</p>}
    <IndexList numbered={false} rows={entries.map((e) => ({ href: `/lab/${e.id}/`, title: e.data.title, summary: e.data.summary, status: e.data.status, meta: e.data.date.getFullYear().toString(), draft: e.data.draft }))} />
  </div>
</Base>

<style>
  .intro { max-width: 52ch; }
  .key { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: center; font: 400 var(--step--2)/1.6 var(--mono); color: var(--muted); }
</style>
