---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('resume', 'resume');
if (!entry) throw new Error('src/content/resume/resume.yaml is missing (npm run import-resume).');
const r = entry.data;

const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const month = (m?: string | null) => (m ? fmt.format(new Date(`${m}-01T00:00:00Z`)) : 'Present');
---

<Base title="Résumé" description={r.summary} noindex={r.draft}>
  <article class="resume prose">
    {r.draft && <p class="banner">Draft résumé: imported, not yet reviewed.</p>}
    <header>
      <h1>{r.name}</h1>
      <p class="muted">{r.headline}{r.location && ` · ${r.location}`}</p>
      <p class="links">
        {r.links.email && <a href={`mailto:${r.links.email}`}>{r.links.email}</a>}
        {r.links.github && <a href={`https://${r.links.github.replace(/^https?:\/\//, '')}`}>GitHub</a>}
        {r.links.linkedin && <a href={`https://${r.links.linkedin.replace(/^https?:\/\//, '')}`}>LinkedIn</a>}
      </p>
    </header>

    <p>{r.summary}</p>

    <h2>Experience</h2>
    {r.experience.map((job) => (
      <section class="job">
        <h3>{job.role} · {job.org}</h3>
        <p class="muted">{month(job.start)} – {month(job.end)}{job.location && ` · ${job.location}`}</p>
        {job.summary && <p>{job.summary}</p>}
        <ul>
          {job.highlights.map((h) => (
            <li>{h.title && <strong>{h.title}: </strong>}{h.text}</li>
          ))}
        </ul>
      </section>
    ))}

    <h2>Skills</h2>
    <dl class="skills">
      {r.skills.map((s) => (
        <>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </>
      ))}
    </dl>

    <h2>Education</h2>
    {r.education.map((ed) => (
      <section>
        <h3>{ed.credential} · {ed.institution}</h3>
        {(ed.start || ed.end) && <p class="muted">{ed.start && `${month(ed.start)} – `}{month(ed.end)}</p>}
        {ed.notes.length > 0 && <ul>{ed.notes.map((n) => <li>{n}</li>)}</ul>}
      </section>
    ))}
  </article>
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 1rem; }
  .job h3, section h3 { margin-bottom: 0; }
  .skills { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; }
  @media (max-width: 40rem) { .skills { grid-template-columns: 1fr; } .skills dd { margin-bottom: 0.5rem; } }

  /* The PDF is this page, printed (P3). */
  @media print {
    :global(.site-header), :global(.site-footer), .banner { display: none; }
    :global(body) { background: white; color: black; font-size: 10.5pt; }
    .resume { max-width: none; }
  }
</style>
