---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, nav } from '../site.config';
import { build } from '../lib/build';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#eceeea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1412" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex" />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a href="/" class="home" aria-current={path === '/' ? 'page' : undefined}>Sean Russell</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" class="wrap" transition:animate="fade">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <div class="links">
        <a href={site.github}>GitHub</a>
        <a href="/resume/">Résumé</a>
        <a href={site.photo}>Photography</a>
      </div>
      <p class="stamp num">
        © {new Date().getFullYear()} Sean Russell
        {build.short && (
          <>
            {' · build '}
            <a href={`${site.github}/sean-russell-dev/commit/${build.sha}`}>{build.short}</a>
            {` · ${build.date}`}
          </>
        )}
      </p>
    </footer>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: var(--space-3); left: var(--space-3); width: auto; height: auto; clip-path: none; background: var(--surface); padding: var(--space-2) var(--space-3); z-index: 10; }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
  }
  .site-header a { color: var(--fg); text-decoration: none; }
  .home { font-weight: 700; letter-spacing: -0.015em; }
  nav { display: flex; gap: var(--space-5); font-size: var(--step--1); }
  .site-header nav a { color: var(--muted); transition: color 0.15s; }
  .site-header nav a:hover { color: var(--fg); }
  .site-header nav a[aria-current='page'] { color: var(--accent); }

  main { min-height: 60vh; }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .links { display: flex; gap: var(--space-5); }
  .links a { color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--fg); }
  .stamp { font: 400 var(--step--2)/1.6 var(--mono); color: var(--muted); }
  .stamp a { color: inherit; }
</style>
