---
// A numbered index: the site's main way of listing things (work, lab, notes).
// Rows, not cards, so a page of them reads like a table of contents.
export interface Row {
  href: string;
  title: string;
  summary: string;
  /** Right-hand meta: a tag, a status, a date. */
  meta?: string;
  status?: 'live' | 'wip' | 'archived';
  draft?: boolean;
}
interface Props {
  rows: Row[];
  numbered?: boolean;
}
const { rows, numbered = true } = Astro.props;
import Status from './Status.astro';
---

<ol class="index" class:list={{ numbered }}>
  {rows.map((row, i) => (
    <li>
      <a href={row.href}>
        {numbered && <span class="n num">{String(i + 1).padStart(2, '0')}</span>}
        <span class="body">
          <span class="title">{row.title}{row.draft && <span class="draft">draft</span>}</span>
          <span class="summary">{row.summary}</span>
        </span>
        <span class="meta">
          {row.status && <Status status={row.status} />}
          {row.meta && <span class="tag">{row.meta}</span>}
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .index { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  li { border-top: 1px solid var(--line); }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .numbered a { grid-template-columns: 2.5rem minmax(0, 1fr) auto; }
  .n { font: 400 var(--step--2)/1 var(--mono); color: var(--muted); transition: color 0.15s; }
  .body { display: grid; gap: 0.15rem; min-width: 0; }
  .title { font-weight: 500; font-size: var(--step-1); letter-spacing: -0.015em; line-height: 1.3; }
  .summary { color: var(--muted); font-size: var(--step--1); line-height: 1.5; }
  .meta { display: flex; gap: var(--space-3); align-items: baseline; justify-content: flex-end; white-space: nowrap; }
  .draft { font: 400 var(--step--2) var(--mono); color: var(--muted); margin-left: var(--space-2); letter-spacing: 0.04em; }
  a:hover .title { color: var(--accent); }
  a:hover .n { color: var(--accent); }

  /* Phones: meta drops under the text instead of squeezing it. */
  @media (max-width: 34rem) {
    a { grid-template-columns: minmax(0, 1fr); }
    .numbered a { grid-template-columns: 2rem minmax(0, 1fr); }
    .meta { justify-content: flex-start; }
    .numbered .meta { grid-column: 2; }
  }
</style>
