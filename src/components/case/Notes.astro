---
// The fine print under a case study: where numbers come from, under what
// conditions, and what's left out on purpose.
---

<aside class="notes">
  <h2 class="label">Notes</h2>
  <div class="body"><slot /></div>
</aside>

<style>
  .notes { display: grid; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .body { display: grid; gap: var(--space-2); font-size: var(--step--1); color: var(--muted); }
  .body :global(p) { margin: 0; }
</style>
