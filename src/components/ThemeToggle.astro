---
// Three states: auto (follow the system, the default), light, dark. The
// choice is data-theme on <html>, applied before first paint by the inline
// script in Base.astro. The label is pure CSS off that attribute, so it can
// never show a stale state, even across view transitions.
---

<button type="button" class="theme" data-theme-toggle aria-label="Colour theme: switch between auto, light and dark">
  <span class="glyph" aria-hidden="true"></span>
  <span class="state auto">auto</span><span class="state light">light</span><span class="state dark">dark</span>
</button>

<script>
  const order = ['auto', 'light', 'dark'] as const;
  // Delegated, so it survives view-transition swaps of the header.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-theme-toggle]')) return;
    const root = document.documentElement;
    const current = (root.dataset.theme as (typeof order)[number]) ?? 'auto';
    const next = order[(order.indexOf(current) + 1) % order.length];
    if (next === 'auto') delete root.dataset.theme;
    else root.dataset.theme = next;
    try {
      if (next === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .theme {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0;
    border: 0;
    background: none;
    font: 400 var(--step--2)/1 var(--mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .theme:hover { color: var(--fg); }
  /* A small dial: half-filled for auto, hollow for light, solid for dark. */
  .glyph { width: 9px; height: 9px; border-radius: 50%; border: 1.25px solid currentColor; background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  :global(:root[data-theme='light']) .glyph { background: transparent; }
  :global(:root[data-theme='dark']) .glyph { background: currentColor; }
  .state { display: none; }
  :global(:root:not([data-theme])) .auto,
  :global(:root[data-theme='light']) .light,
  :global(:root[data-theme='dark']) .dark { display: inline; }
</style>
