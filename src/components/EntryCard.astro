---
interface Props {
  href: string;
  title: string;
  summary: string;
  tags?: string[];
  badge?: string;
}
const { href, title, summary, tags = [], badge } = Astro.props;
---

<li>
  <a class="card" href={href}>
    <h3>{title}</h3>
    <p>{summary}</p>
    {badge && <span class="tag">{badge}</span>}
    {tags.map((t) => <span class="tag">{t}</span>)}
  </a>
</li>
