---
// A small live readout: a latency sparkline plus summary numbers. Fed by the
// /status probe once it exists (P4); until then it only appears with example
// data in the design-system lab entry. Never render invented numbers on the
// front of the site.
interface Props {
  /** Latency samples in ms, oldest first. */
  samples: number[];
  uptime: number;
  p50: number;
  window: string;
  example?: boolean;
}
const { samples, uptime, p50, window, example = false } = Astro.props;

const W = 160, H = 24, pad = 2;
const lo = Math.min(...samples), hi = Math.max(...samples);
const y = (v: number) => pad + (H - 2 * pad) * (1 - (v - lo) / (hi - lo || 1));
const points = samples.map((v, i) => `${((i / (samples.length - 1)) * W).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const last = samples.at(-1)!;
---

<div class="trace">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`Latency over ${window}`}>
    <polyline points={points} fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" />
    <circle cx={W} cy={y(last)} r="2" fill="currentColor" />
  </svg>
  <span class="readout num">
    <b>{uptime.toFixed(2)}%</b> up · p50 <b>{p50} ms</b> · {window}{example && ' · example data'}
  </span>
</div>

<style>
  .trace { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--accent); }
  svg { overflow: visible; flex: none; }
  .readout { font: 400 var(--step--2)/1.3 var(--mono); color: var(--muted); }
  b { font-weight: 500; color: var(--fg); }
  @media (prefers-reduced-motion: no-preference) {
    polyline { stroke-dasharray: 420; stroke-dashoffset: 420; animation: draw 1.4s ease-out 0.15s forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
  }
</style>
