---
// One journey library, two targets, one verdict, two destinations. Drawn in the
// page's tokens so it follows the theme.
const w = 186, h = 62;
const x = [16, 238, 460, 682];
const y = { top: 24, mid: 91, bot: 158 };
const nodes = [
  { x: x[0], y: y.mid, name: 'Journey library', sub: '11 journeys, written once' },
  { x: x[1], y: y.top, name: 'Stage smoke', sub: 'after every release' },
  { x: x[1], y: y.bot, name: 'Production probe', sub: '9 live, every 15 min', accent: true },
  { x: x[2], y: y.mid, name: 'Shared CI step', sub: 'verdict + diagnosis' },
  { x: x[3], y: y.top, name: 'On-call alert', sub: 'what failed, where, why' },
  { x: x[3], y: y.bot, name: 'Releases app', sub: 'reports, traces, history' },
];
// Elbow connectors: out of a node's right edge, into another's left edge.
const elbow = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  return `M ${x1} ${y1} H ${mx} V ${y2} H ${x2 - 6}`;
};
const arrow = (x2: number, y2: number) => `M ${x2 - 12} ${y2 - 5} L ${x2 - 3} ${y2} L ${x2 - 12} ${y2 + 5}`;
const c = (n: { y: number }) => n.y + h / 2;
const links: [number, number][] = [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [3, 5]];
---

<svg viewBox="0 0 884 244" role="img" aria-labelledby="sm-pipe-title sm-pipe-desc" class="diagram">
  <title id="sm-pipe-title">Synthetic monitoring, end to end</title>
  <desc id="sm-pipe-desc">
    One library of user journeys runs against stage after every release and against production every
    15 minutes. A shared CI step turns each run into a verdict and a diagnosis, which goes to the
    on-call alert channel and to an internal releases app.
  </desc>
  {links.map(([a, b]) => {
    const from = nodes[a], to = nodes[b];
    return (
      <g>
        <path d={elbow(from.x + w, c(from), to.x, c(to))} class="edge" />
        <path d={arrow(to.x, c(to))} class="edge" />
      </g>
    );
  })}
  {nodes.map((n) => (
    <g>
      <rect x={n.x} y={n.y} width={w} height={h} rx="6" class:list={['node', { accent: n.accent }]} />
      <text x={n.x + 14} y={n.y + 27} class="name">{n.name}</text>
      <text x={n.x + 14} y={n.y + 47} class="sub">{n.sub}</text>
    </g>
  ))}
</svg>

<style>
  .diagram { display: block; width: 100%; height: auto; background: var(--surface); }
  .node { fill: var(--bg); stroke: var(--line); stroke-width: 1.25; }
  .node.accent { stroke: var(--accent); }
  .name { font: 500 15px var(--sans); fill: var(--fg); }
  .sub { font: 400 11px var(--mono); fill: var(--muted); }
  .edge { fill: none; stroke: var(--muted); stroke-width: 1.25; stroke-linejoin: round; }
</style>
