---
// The path a schema change takes, as rows rather than an SVG so the text stays
// readable at phone width. From the evidence export, case study 5.
const rows: [trigger: string, happens: string, schemas: string, presets: string][] = [
  ['Pull request', 'The schema change is reviewed like code', 'Nothing moves yet', 'Nothing moves yet'],
  ['Merge to main', 'Deploys dev and syncs the schemas', 'Pushed to the dev space', "Dev's own, re-seeded by the sync"],
  ['Production release', 'Deploys prod and promotes the schemas', 'Exactly what is committed', 'The committed ones, mirrored in'],
];
---

<ol class="path">
  {rows.map(([trigger, happens, schemas, presets]) => (
    <li class="step">
      <span class="trigger label">{trigger}</span>
      <p class="happens">{happens}</p>
      <dl class="owned">
        <div><dt>Schemas</dt><dd>{schemas}</dd></div>
        <div><dt>Presets</dt><dd>{presets}</dd></div>
      </dl>
    </li>
  ))}
</ol>

<style>
  .path { display: grid; margin: 0; padding: var(--space-4); list-style: none; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .step { display: grid; gap: var(--space-1); padding-block: var(--space-3); border-bottom: 1px solid var(--line); }
  .step:first-child { padding-top: 0; }
  .step:last-child { padding-bottom: 0; border-bottom: 0; }
  .trigger { color: var(--accent); }
  .happens { margin: 0; font-size: var(--step--1); line-height: 1.4; }
  .owned { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: var(--space-1) 0 0; }
  dt { font: 500 var(--step--2)/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0; font-size: var(--step--1); line-height: 1.3; color: var(--muted); }
  @media (max-width: 34rem) {
    .path { padding: var(--space-3); }
    .owned { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
  }
</style>
