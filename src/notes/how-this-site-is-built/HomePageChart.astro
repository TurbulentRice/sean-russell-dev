---
// What the home page downloads, in compressed bytes. Built in HTML rather than
// SVG so the labels stay readable at phone width. Measured in production on
// 2026-10-30; the numbers are a snapshot, so they live here and not in a build.
const rows: [item: string, detail: string, kb: number][] = [
  ['Body typeface', 'Schibsted Grotesk', 46.8],
  ['Mono typeface', 'IBM Plex Mono, two weights', 29.6],
  ['Analytics', 'Added by Cloudflare at the edge', 10.3],
  ['The page', 'All of its HTML and CSS', 6.6],
  ['Page transitions', 'The only script of mine that loads', 5.9],
  ['React', 'Installed, deployed, never requested', 0],
];
const max = rows[0][2];
const total = rows.reduce((sum, [, , kb]) => sum + kb, 0);
---

<div class="chart" role="table" aria-label="What the home page downloads, in kilobytes">
  <div class="row head" role="row">
    <span role="columnheader">Item</span>
    <span role="columnheader" class="size">KB</span>
  </div>
  {rows.map(([item, detail, kb]) => (
    <div class="row" role="row">
      <span role="rowheader" class="item">
        <span class="item-name">{item}</span>
        <span class="item-detail">{detail}</span>
      </span>
      <span role="cell" class="size num">{kb.toFixed(1)}</span>
      <span class="track" aria-hidden="true">
        <span class="bar" style={`width: ${(kb / max) * 100}%`}></span>
      </span>
    </div>
  ))}
  <div class="row total" role="row">
    <span role="rowheader" class="item-name">Total</span>
    <span role="cell" class="size num">{total.toFixed(1)}</span>
  </div>
</div>

<style>
  .chart { display: grid; padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 0; }
  .head { font: 500 var(--step--2)/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .item { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); align-items: baseline; }
  .item-name { font-size: var(--step--1); line-height: 1.3; }
  .item-detail { font-size: var(--step--2); line-height: 1.3; color: var(--muted); }
  .size { text-align: right; font: 500 var(--step--1) var(--mono); }
  .head .size { font: inherit; }
  .track { grid-column: 1 / -1; height: 6px; }
  .bar { display: block; height: 100%; min-width: 1px; background: var(--accent); }
  .total .item-name { font-weight: 500; }
</style>
